{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gitbridge:schema:error.v1",
  "title": "Error Contract",
  "description": "Error contract (spec 11.1). Mirrors ErrorCode.kt with full category, http_status, retryable, and execution_state mappings plus DV-RTB-BACKOFF bounds.",
  "x-retry-backoff": {
    "strategy": "exponential_full_jitter",
    "initial_seconds": 1,
    "multiplier": 2,
    "max_seconds": 60,
    "max_attempts": 5
  },
  "x-catalog": {
    "AUTH_FAILED": { "category": "AUTHENTICATION", "http_status": 401, "retryable": false, "execution_state": "NOT_STARTED" },
    "FORBIDDEN": { "category": "AUTHORIZATION", "http_status": 403, "retryable": false, "execution_state": "NOT_STARTED" },
    "POLICY_DENIED": { "category": "POLICY", "http_status": 403, "retryable": false, "execution_state": "NOT_STARTED" },
    "APPROVAL_DECLINED": { "category": "AUTHORIZATION", "http_status": 403, "retryable": false, "execution_state": "NOT_STARTED" },
    "VALIDATION_FAILED": { "category": "VALIDATION", "http_status": 400, "retryable": false, "execution_state": "NOT_STARTED" },
    "UNSUPPORTED_VERSION": { "category": "VALIDATION", "http_status": 400, "retryable": false, "execution_state": "NOT_STARTED" },
    "EXPIRED": { "category": "VALIDATION", "http_status": 400, "retryable": false, "execution_state": "NOT_STARTED" },
    "REPLAY_DETECTED": { "category": "VALIDATION", "http_status": 409, "retryable": false, "execution_state": "NOT_STARTED" },
    "NOT_FOUND": { "category": "PROVIDER", "http_status": 404, "retryable": false, "execution_state": "FAILED" },
    "CONFLICT": { "category": "PROVIDER", "http_status": 409, "retryable": false, "execution_state": "FAILED" },
    "UNSUPPORTED_CONTENT": { "category": "VALIDATION", "http_status": 422, "retryable": false, "execution_state": "FAILED" },
    "PAYLOAD_TOO_LARGE": { "category": "RESOURCE_LIMIT", "http_status": 413, "retryable": false, "execution_state": "NOT_STARTED" },
    "RATE_LIMITED": { "category": "RESOURCE_LIMIT", "http_status": 429, "retryable": true, "execution_state": "NOT_STARTED" },
    "UPSTREAM_UNAVAILABLE": { "category": "PROVIDER", "http_status": 503, "retryable": true, "execution_state": "FAILED" },
    "TIMEOUT": { "category": "TRANSPORT", "http_status": 504, "retryable": false, "execution_state": "FAILED" },
    "OUTCOME_UNKNOWN": { "category": "TRANSPORT", "http_status": 504, "retryable": false, "execution_state": "OUTCOME_UNKNOWN" },
    "NOT_IMPLEMENTED": { "category": "INTERNAL", "http_status": 501, "retryable": false, "execution_state": "NOT_STARTED" },
    "INTERNAL": { "category": "INTERNAL", "http_status": 500, "retryable": false, "execution_state": "FAILED" }
  },
  "$defs": {
    "ErrorCode": {
      "type": "string",
      "enum": [
        "AUTH_FAILED",
        "FORBIDDEN",
        "POLICY_DENIED",
        "APPROVAL_DECLINED",
        "VALIDATION_FAILED",
        "UNSUPPORTED_VERSION",
        "EXPIRED",
        "REPLAY_DETECTED",
        "NOT_FOUND",
        "CONFLICT",
        "UNSUPPORTED_CONTENT",
        "PAYLOAD_TOO_LARGE",
        "RATE_LIMITED",
        "UPSTREAM_UNAVAILABLE",
        "TIMEOUT",
        "OUTCOME_UNKNOWN",
        "NOT_IMPLEMENTED",
        "INTERNAL"
      ]
    },
    "ErrorCategory": {
      "type": "string",
      "enum": [
        "VALIDATION",
        "AUTHENTICATION",
        "AUTHORIZATION",
        "POLICY",
        "TRANSPORT",
        "PROVIDER",
        "RESOURCE_LIMIT",
        "INTERNAL"
      ]
    },
    "ExecutionState": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "EXECUTING",
        "SUCCEEDED",
        "FAILED",
        "OUTCOME_UNKNOWN"
      ]
    },
    "BridgeError": {
      "type": "object",
      "required": [
        "code",
        "category",
        "retryable",
        "execution_state",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "category": {
          "$ref": "#/$defs/ErrorCategory"
        },
        "http_status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599,
          "description": "Local HTTP status, where applicable."
        },
        "retryable": {
          "type": "boolean",
          "description": "Whether retry is safe and recommended."
        },
        "execution_state": {
          "$ref": "#/$defs/ExecutionState"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Sanitized, user-readable. Must not contain credentials, file content or raw upstream bodies."
        },
        "correlation_id": {
          "$ref": "urn:gitbridge:schema:common.v1#/$defs/CorrelationId"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "OUTCOME_UNKNOWN"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "execution_state": {
                "const": "OUTCOME_UNKNOWN"
              },
              "retryable": {
                "const": false
              }
            },
            "description": "RTB-44: an unknown outcome must be reconciled before any retry."
          }
        }
      ]
    }
  }
}
