{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gitbridge:schema:authorization.v1",
  "title": "Authorization Contract",
  "description": "Policy decision returned by the phone-side policy engine (spec 4.3, 6.2), mirroring PolicyDecision.kt. Authorization is always enforced on the phone (RTB-32); relay assertions and agent tool schemas are advisory only.",
  "$defs": {
    "PolicyDecision": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "decision"
          ],
          "additionalProperties": false,
          "properties": {
            "decision": {
              "const": "allow"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "decision",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "decision": {
              "const": "require_approval"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        {
          "type": "object",
          "required": [
            "decision",
            "code",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "decision": {
              "const": "deny"
            },
            "code": {
              "$ref": "urn:gitbridge:schema:error.v1#/$defs/ErrorCode"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      ]
    }
  }
}
