{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gitbridge:schema:lifecycle.v1",
  "title": "Execution Lifecycle Contract",
  "description": "Request states and allowed transitions (spec 8.3), mirroring RequestState.kt. Edges involving MANUAL_REVIEW and CANCELLED are proposals pending review, as noted in RequestState.kt. Terminal states: SUCCEEDED, FAILED, EXPIRED, REJECTED, CANCELLED.",
  "$defs": {
    "State": {
      "type": "string",
      "enum": [
        "RECEIVED",
        "AUTHORIZED",
        "AWAITING_APPROVAL",
        "EXECUTING",
        "SUCCEEDED",
        "FAILED",
        "OUTCOME_UNKNOWN",
        "RECONCILING",
        "MANUAL_REVIEW",
        "EXPIRED",
        "REJECTED",
        "CANCELLED"
      ]
    },
    "Transition": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/State"
        },
        "to": {
          "$ref": "#/$defs/State"
        },
        "at": {
          "$ref": "urn:gitbridge:schema:common.v1#/$defs/Timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "from": {
                "const": "RECEIVED"
              }
            },
            "required": [
              "from"
            ]
          },
          "then": {
            "properties": {
              "to": {
                "enum": [
                  "AUTHORIZED",
                  "REJECTED",
                  "EXPIRED",
                  "CANCELLED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "from": {
                "const": "AUTHORIZED"
              }
            },
            "required": [
              "from"
            ]
          },
          "then": {
            "properties": {
              "to": {
                "enum": [
                  "AWAITING_APPROVAL",
                  "EXECUTING",
                  "REJECTED",
                  "CANCELLED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "from": {
                "const": "AWAITING_APPROVAL"
              }
            },
            "required": [
              "from"
            ]
          },
          "then": {
            "properties": {
              "to": {
                "enum": [
                  "EXECUTING",
                  "REJECTED",
                  "EXPIRED",
                  "CANCELLED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "from": {
                "const": "EXECUTING"
              }
            },
            "required": [
              "from"
            ]
          },
          "then": {
            "properties": {
              "to": {
                "enum": [
                  "SUCCEEDED",
                  "FAILED",
                  "OUTCOME_UNKNOWN"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "from": {
                "const": "OUTCOME_UNKNOWN"
              }
            },
            "required": [
              "from"
            ]
          },
          "then": {
            "properties": {
              "to": {
                "enum": [
                  "RECONCILING",
                  "MANUAL_REVIEW"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "from": {
                "const": "RECONCILING"
              }
            },
            "required": [
              "from"
            ]
          },
          "then": {
            "properties": {
              "to": {
                "enum": [
                  "SUCCEEDED",
                  "FAILED",
                  "MANUAL_REVIEW"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "from": {
                "const": "MANUAL_REVIEW"
              }
            },
            "required": [
              "from"
            ]
          },
          "then": {
            "properties": {
              "to": {
                "enum": [
                  "SUCCEEDED",
                  "FAILED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "from": {
                "enum": [
                  "SUCCEEDED",
                  "FAILED",
                  "EXPIRED",
                  "REJECTED",
                  "CANCELLED"
                ]
              }
            },
            "required": [
              "from"
            ]
          },
          "then": false
        }
      ]
    },
    "RequestStatus": {
      "type": "object",
      "required": [
        "request_id",
        "state"
      ],
      "additionalProperties": true,
      "description": "Body of GET /api/v1/requests/{request_id}. Carries no tool arguments or file content.",
      "properties": {
        "request_id": {
          "$ref": "urn:gitbridge:schema:common.v1#/$defs/RequestId"
        },
        "state": {
          "$ref": "#/$defs/State"
        },
        "updated_at": {
          "$ref": "urn:gitbridge:schema:common.v1#/$defs/Timestamp"
        },
        "error": {
          "$ref": "urn:gitbridge:schema:error.v1#/$defs/BridgeError"
        }
      }
    }
  }
}
